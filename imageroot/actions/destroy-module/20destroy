# Remove both Traefik routes opened by configure-module (only if they were
# created: deleting an unknown route makes the traefik action fail).

import json
import os
import sys

import agent
import agent.tasks

json.load(sys.stdin)

if os.path.exists(".traefik-routes"):
    module_id = os.environ["MODULE_ID"]
    traefik_id = agent.resolve_agent_id("traefik@node")
    if traefik_id is None:
        sys.exit(2)
    for instance in (module_id, module_id + "-phish"):
        response = agent.tasks.run(
            agent_id=traefik_id,
            action="delete-route",
            data={"instance": instance},
        )
        agent.assert_exp(response["exit_code"] == 0)
