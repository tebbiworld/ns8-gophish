# Remove the Traefik routes this module created. The admin route is tracked by
# .traefik-routes; the phish route only exists when the module managed it
# (.phish-route). A phish route the admin created by hand is theirs to remove.
# Deleting a route that does not exist makes the traefik action fail, so each
# deletion is guarded by its marker.

import json
import os
import sys

import agent
import agent.tasks

json.load(sys.stdin)

module_id = os.environ["MODULE_ID"]
to_delete = []
if os.path.exists(".traefik-routes"):
    to_delete.append(module_id)
if os.path.exists(".phish-route"):
    to_delete.append(module_id + "-phish")

if to_delete:
    traefik_id = agent.resolve_agent_id("traefik@node")
    if traefik_id is None:
        sys.exit(2)
    for instance in to_delete:
        response = agent.tasks.run(
            agent_id=traefik_id,
            action="delete-route",
            data={"instance": instance},
        )
        agent.assert_exp(response["exit_code"] == 0)
