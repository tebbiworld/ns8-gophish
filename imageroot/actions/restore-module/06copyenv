# Carry the settings of the backed-up instance over to the new one. The TCP
# ports are freshly assigned on the new instance, so they are NOT copied.

import json
import sys

import agent

request = json.load(sys.stdin)
env = request["environment"]
keep = ["GOPHISH_ADMIN_HOST", "GOPHISH_PHISH_HOST", "GOPHISH_CONTACT_ADDRESS", "TRAEFIK_ADMIN_HTTP2HTTPS"]
agent.mset_env({k: env[k] for k in keep if k in env})
