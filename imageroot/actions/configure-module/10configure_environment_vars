# Persist the settings in state/environment and write state/gophish.env, the
# env file the container reads. The container entrypoint turns these variables
# into config.json inside the data volume at every start.

import json
import os
import sys

import agent

data = json.load(sys.stdin)

admin_host = (data["admin_host"]).strip().lower()
phish_host = (data["phish_host"]).strip().lower()
contact = (data.get("contact_address") or "").strip()

agent.mset_env({
    "GOPHISH_ADMIN_HOST": admin_host,
    "GOPHISH_PHISH_HOST": phish_host,
    "GOPHISH_CONTACT_ADDRESS": contact,
    "TRAEFIK_ADMIN_HTTP2HTTPS": "True" if data.get("http2https", True) else "False",
})

# Container env file (--env-file). Values are written one KEY=VALUE per line;
# the entrypoint reads them and JSON-escapes with jq, so no quoting here.
lines = [
    "# Generated by configure-module. Do not edit by hand.",
    f"GOPHISH_ADMIN_HOST={admin_host}",
    f"GOPHISH_PHISH_HOST={phish_host}",
    f"GOPHISH_CONTACT_ADDRESS={contact}",
]
with open("gophish.env.tmp", "w") as fp:
    fp.write("\n".join(lines) + "\n")
os.replace("gophish.env.tmp", "gophish.env")
