# Checks beyond the JSON schema: the two host names must differ and must not
# already be used by another Traefik route on the node.

import json
import os
import sys

import agent

agent.set_weight(os.path.basename(__file__), 0)

data = json.load(sys.stdin)
errors = []

def fail(field, value, error):
    errors.append({"field": field, "parameter": field, "value": value, "error": error})

admin_host = (data.get("admin_host") or "").strip().lower()
phish_host = (data.get("phish_host") or "").strip().lower()

if admin_host and phish_host and admin_host == phish_host:
    fail("phish_host", phish_host, "hosts_must_differ")

# A host name change must not collide with a route owned by another module.
# Our own current host names (admin and phish) are allowed.
own = {os.environ.get("GOPHISH_ADMIN_HOST", "").lower(), os.environ.get("GOPHISH_PHISH_HOST", "").lower()}
for field, host in (("admin_host", admin_host), ("phish_host", phish_host)):
    if host and host not in own and agent.http_route_in_use(domain=host):
        fail(field, host, "domain_already_used_in_traefik")

if errors:
    agent.set_status("validation-failed")
    json.dump(errors, fp=sys.stdout)
    sys.exit(2)
