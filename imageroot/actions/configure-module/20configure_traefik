# Publish two independent Traefik routes for the one GoPhish instance:
#   instance <module_id>        admin_host  -> 127.0.0.1:${ADMIN_PORT} (admin 3333)
#   instance <module_id>-phish  phish_host  -> 127.0.0.1:${PHISH_PORT} (phish 80)
# Traefik terminates TLS for both; inside the container both servers are plain
# HTTP (use_tls=false). A marker records that the routes exist so destroy-module
# only tries to delete them when they were created.

import json
import os
import sys

import agent

data = json.load(sys.stdin)
env = os.environ
module_id = env["MODULE_ID"]
h2hs = data.get("http2https", True)


def make_route(instance, host, port):
    route = {
        "instance": instance,
        "url": "http://127.0.0.1:" + str(port),
        "host": host,
        "http2https": h2hs,
        "lets_encrypt_check": True,
        "lets_encrypt_cleanup": True,
    }
    if "lets_encrypt" in data:
        route["lets_encrypt"] = data["lets_encrypt"]
    return route


agent.set_route(make_route(module_id, data["admin_host"].strip().lower(), env["ADMIN_PORT"]))
agent.set_route(make_route(module_id + "-phish", data["phish_host"].strip().lower(), env["PHISH_PORT"]))

open(".traefik-routes", "w").close()  # remembered for destroy-module
